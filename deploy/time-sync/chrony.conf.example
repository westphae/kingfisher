# Kingfisher UART-only GNSS discipline example.
# Merge this into /etc/chrony/chrony.conf or /etc/chrony.conf as appropriate.
#
# Boot policy: allow a few early steps, then slew only.
makestep 1.0 3
rtcsync

# Optional: enable when the Pi has reliable internet and you want NTP as well.
# While pool sources are reachable, chrony may ignore a mis-tuned GPS refclock.
# For offline-first flight recording, leave this commented out.
#pool pool.ntp.org iburst

# gpsd serial-time SOCK for /dev/ttyAMA0.
# Recent gpsd uses chrony.clk.<device>.sock for serial time and chrony.<pps>.sock
# for PPS time.
#
# Tune with chronyc sourcestats at offset 0.0 (NTP-synced): use the same sign
# as the GPS Offset column in seconds (+620ms -> offset 0.62 on this M9N path).
refclock SOCK /run/chrony.clk.ttyAMA0.sock refid GPS precision 1e-1 offset 0.62 delay 0.1

# PPS follow-on (GPIO 18 -> /dev/pps0, also in gpsd DEVICES). Use SOCK PPS —
# do not also enable refclock PPS /dev/pps0; gpsd holds the device.
# refclock SOCK /run/chrony.pps0.sock refid PPS precision 1e-7 lock GPS
