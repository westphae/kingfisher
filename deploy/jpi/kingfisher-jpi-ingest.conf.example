# Optional override: /etc/kingfisher-jpi-ingest.conf
# The file the Pi uses is ~/.config/kingfisher/jpi.env (see jpi.env.example).
# That file is outside the repo. This /etc file, when present, is sourced
# after it. Neither file holds key bytes; SSH_KEY is only a path.

RAW_DIR="${HOME}/kingfisher/engine/raw"
FLIGHTS_DIR="${HOME}/kingfisher/flights"
LEDGER="${HOME}/kingfisher/engine/ingest.json"
REPO="${HOME}/go/src/github.com/westphae/kingfisher"

# none | ssh | rsyncd
TRANSPORT="ssh"
REQUIRE_IFACE="wlan1"
NAS_HOST="192.168.86.40"

# Restricted key. The NAS account is forced to `rrsync -ro` rooted at the
# JPI folder, so the source is eric@192.168.86.40: and NAS_PATH stays empty.
SSH_USER="eric"
SSH_PORT="22"
SSH_KEY="${HOME}/.ssh/nas_ro"
NAS_PATH=""

# Unused unless TRANSPORT=rsyncd. The password file, if any, also stays
# outside the repo.
RSYNC_USER="kingfisher"
RSYNC_MODULE="bonanza"
RSYNC_MODULE_PATH="JPI"
RSYNC_SECRET="${HOME}/.config/kingfisher/jpi.secret"
