# Copy to ~/.config/kingfisher/jpi.env (outside the git checkout) and chmod 600.
# The NAS key stays at ~/.ssh/nas_ro on the Pi. This file only names that path.
# Do not commit jpi.env, the key, a .pub, or a host key.

TRANSPORT="ssh"
REQUIRE_IFACE="wlan1"
NAS_HOST="192.168.86.40"
SSH_USER="eric"
SSH_PORT="22"
SSH_KEY="${HOME}/.ssh/nas_ro"

# The NAS account is forced to `rrsync -ro` rooted at the JPI folder, so the
# rsync source is user@host: with an empty path. Do not put a volume path here.
NAS_PATH=""

RAW_DIR="${HOME}/kingfisher/engine/raw"
FLIGHTS_DIR="${HOME}/kingfisher/flights"
LEDGER="${HOME}/kingfisher/engine/ingest.json"
REPO="${HOME}/go/src/github.com/westphae/kingfisher"
