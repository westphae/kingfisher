# Kingfisher systemd *user* unit — runs as your login user (IIO, config, flight DBs).
#
# Install (binary via go install → GOBIN or $(go env GOPATH)/bin):
#
#   go install ./cmd/kingfisher
#   mkdir -p ~/.config/systemd/user
#   bin="$(go env GOBIN)"; [ -z "$bin" ] && bin="$(go env GOPATH)/bin"
#   sed "s|__KINGFISHER_BIN__|$bin/kingfisher|g" \
#     deploy/systemd/kingfisher.service.example \
#     > ~/.config/systemd/user/kingfisher.service
#   sudo loginctl enable-linger "$USER"    # start at boot without an SSH session
#   systemctl --user daemon-reload
#   systemctl --user enable --now kingfisher.service
#   journalctl --user-unit=kingfisher.service -f
#
# See README.md § "systemd user service (boot)" for ordering with chrony/gpsd and Caddy.

[Unit]
Description=Kingfisher flight data recorder
Documentation=file://%h/go/src/github.com/westphae/kingfisher/README.md
# NOTE: this is a *user* unit. After=/Wants= on system units (chronyd/gpsd/
# network-online) are NO-OPs here — a user-session unit cannot order against
# system units. Kingfisher deliberately does NOT wait for chrony: it starts
# (UI + recording) immediately on the RTC clock, shows a cockpit banner until
# chrony syncs, and logs any clock step/slew to the flight DB's clock_offsets
# table so timestamps are correctable post-flight (docs/timestamps.md). An
# implausible clock (dead RTC → 1970) only changes the DB *filename* to a
# fallback unsynced_NNNN name, renamed at close once true time is known.

[Service]
Type=simple
ExecStart=__KINGFISHER_BIN__
Restart=on-failure
RestartSec=30
TimeoutStopSec=45

# Journal rate-limit backstop. The app logs on state changes only (GPS loss,
# gdl90 client errors, throttle/undervolt), so it stays far below this — the
# limit exists so a future runaway per-cycle logger can't rotate the journal
# and erase flight evidence, as happened 2026-07-11. journald's global rate
# limit still applies on top. 300/30 s leaves headroom for startup/panic bursts;
# don't tighten much further or you risk clipping those.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

# Flight DBs default to ~/kingfisher/flights; config to ~/.config/kingfisher/config.json
# WorkingDirectory=%h

[Install]
WantedBy=default.target
