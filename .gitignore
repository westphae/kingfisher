# Local working files — kept out of the repo.
datasheets/
docs/reports/
research/
.grok/
*.log

# Build artefacts.
/kingfisher
/podprobe
target/
*.test

# Python (uv / venv)
.venv/
**/.venv/
**/__pycache__/
*.py[cod]
.python-version

# Pilot JPI / EDM-930 USB dumps and CSV exports. Private flight logs stay
# local. The README and the small synthetic fixtures are the exceptions.
analysis/testdata/jpi/*
!analysis/testdata/jpi/README.md
!analysis/testdata/jpi/synthetic_edm930.jpi
!analysis/testdata/jpi/synthetic_edm930.csv

# Editor / OS.
*.swp
.DS_Store
.idea/

# SSH keys and local env. The JPI NAS key is ~/.ssh/nas_ro on the Pi and is
# named by path from ~/.config/kingfisher/jpi.env. Never commit a key, a
# host key, or that env file. jpi.env.example is the only placeholder.
*.pem
id_*
nas_ro*
known_hosts
*.env
!jpi.env.example
